# AcademicHub Server Environment Variables Template
PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here
MONGO_URI=mongodb://localhost:27017/academichub
GEMINI_API_KEY=your_gemini_api_key_here

# Email / SMTP Configuration for Real OTP Delivery (Optional in dev; fallback logger active)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="AcademicHub Security" <noreply@academichub.edu>
